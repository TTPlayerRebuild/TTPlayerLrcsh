#include <winver.h>
1 VERSIONINFO
FILEVERSION @LRCSH_FIXED_VERSION@
PRODUCTVERSION @LRCSH_FIXED_VERSION@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Sonic853\0"
      VALUE "FileDescription", "TTPlayer lyrics search add-in\0"
      VALUE "FileVersion", "@LRCSH_BUILD_VERSION@\0"
      VALUE "InternalName", "ttp_lrcsh\0"
      VALUE "OriginalFilename", "ttp_lrcsh.dll\0"
      VALUE "ProductName", "TTPlayer Rebuild LRCSH\0"
      VALUE "ProductVersion", "@LRCSH_BUILD_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
